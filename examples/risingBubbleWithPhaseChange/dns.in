F                              ! restart_Multiphase_Heat             !True if you want to restart from multiphase simulation with heat-transfer
1 100000000 10000000 1000000 1000000   10000 ! icheck, iout0d, iout1d, iout2d, iout3d, isave
D D  N N  N N
N N  D D  N N                 ! cbcvel(0:1,1:3,2) [v BC type]
