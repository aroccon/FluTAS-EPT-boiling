100.0 1000.0  1.0 10.0          ! rho1, rho2, mu1,mu2 !1 corr to dispersed phase1 
bub			                    ! inipsi -> type 'bub': bub-single bubble
1				                ! nbub - old
0.5 0.5 0.5 0.25                ! xc, yc, zc, r - location and size of initial bubble
N N  N N  N N 		            ! cbcpsi -> Boundary conditions of phase field variable
0. 0. 0. 0. 0. 0.		        ! bcpsi -> Boundary values  of phase field variable
24.4525d0 1.d0		           	! sigma, sigma_t   -> Surface tension
F 10000    		            	! late_init,i_late_init  -> old
3.0 1.0                         ! gamma_v, eps_int ! eps_int will be mult by the grid size (Interface thickness and regularization speed)
D D  N N  N N                   ! cbcnor x         !gamma_v will be mult by maximum velocity
N N  D D  N N                   ! cbcnor y
N N  N N  D D                   ! cbcnor z         ! Set BC's for normal vectors
0. 0. 0. 0. 0. 0.               ! bcnor x
0. 0. 0. 0. 0. 0.               ! bcnor y
0. 0. 0. 0. 0. 0.               ! bcnor z
90.0                            ! Contact angle with z0 wall in degrees