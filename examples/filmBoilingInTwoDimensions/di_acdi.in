5 200 0.005 0.1                 ! rho1, rho2, mu1,mu2 !1 corr to dispersed phase1 0.00013 0.002825
flm			                    ! inipsi: -> type 'flm' initializes a gas film according toEq. 32 in  Sun et al. (2014), DOI: 10.1080/10407790.2014.915681
1				                ! nbub - no effect for 'flm'
0.001 0.02 0.21 0.007           ! xc, yc, zc=0.001, r  0.001 0.003 - no effect for 'flm'
P P  N N  N N 		            ! cbcpsi -> Boundary conditions of phase field variable
0. 0. 0. 0. 0. 0.		        ! bcpsi -> Boundary values  of phase field variable
0.1d0 1.d0		             	! sigma, sigma_t 0.06d0 -> surface tension
F 10000    		    	        ! late_init,i_late_init -> old
4.0 1.0                         ! gamma_v, eps_int !eps_int will be mult by the grid size 
P P  N N  N N 		            ! cbcnor x         !gamma_v will be mult by maximum velocity
P P  D D  N N                   ! cbcnor y
P P  N N  N N                   ! cbcnor z         ! Set BC's for normal vectors
0. 0. 0. 0. 0. 0.		        ! bcnor x
0. 0. 0. 0. 0. 0.               ! bcnor y
0. 0. 0. 0. 0. 0.               ! bcnor z
1                               ! Contact angle with z0 wall in degrees (selected hydrophobic for stable gas film)
