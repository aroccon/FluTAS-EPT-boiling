2 100 300                      ! itot, jtot, ktot
0.000786844  0.0393422  0.1180266  ! lx, ly, lz
0.0                            ! gr
0.4 5e-6                       ! cfl, dt_input
F                              ! constant_dt   !variable time-step is not yet-validated 
ab2 cen                        ! time_scheme, space_scheme_mom !only centeral scheme is available
1.0 1.                         ! rho_sp, mu_sp !these are useless, please set the parameters in ACDI.IN
zer                            ! inivel
F hkv                          ! is_wallturb, wallturb_type 
cfr                            ! bulk_ftype
1000000 2.5 1000               ! nstep,time_max,tw_max
F T F                          ! stop_type(1:3)
F                              ! restart                             !Always True if you want to restart
F                              ! restart_single_phase                !True if you want to restart from single phase-simulation  results
F                              ! restart_multiphase                  !True if you want to restart from multiphase-simulation  results 
F                              ! restart_multiphase_scalar           !True if you want to restart from multiphase simulation with scalar fields
F                              ! restart_Multiphase_Heat             !True if you want to restart from multiphase simulation with heat-transfer
1 100000000 10000000 1000000 1000000  20000 ! icheck, iout0d, iout1d, iout2d, iout3d, isave
P P  N N  D N                  ! cbcvel(0:1,1:3,1) [u BC type]
P P  D D  D N                  ! cbcvel(0:1,1:3,2) [v BC type]
P P  N N  D N                  ! cbcvel(0:1,1:3,3) [w BC type]
P P  N N  N D                  ! cbcpre(0:1,1:3  ) [p BC type]
0. 0.  0. 0.  0. 0.            ! bcvel(0:1,1:3,1) [u BC value]
0. 0.  0. 0.  0. 0.            ! bcvel(0:1,1:3,2) [v BC value]
0. 0.  0. 0.  0. 0.            ! bcvel(0:1,1:3,3) [w BC value]
0. 0.  0. 0.  0. 0.            ! bcpre(0:1,1:3  ) [p BC value]
F F F                          ! is_forced(1:3)
0. 0. -9.81                    ! gacc_x,gacc_y,gacc_z
0. 0. 0.                       ! bvel_x,bvel_y,bvel_z
0. 0. 0.                       ! dpdl_x,dpdl_y,dpdl_z
F F  F F  F T                  ! is_outflow(0:1,1:3)
1 25                           ! dims_in(1:2)
4                              ! numthreadsmax
