# Compiler definitions
#
# NVFORTRAN (cpu/gpu version)
#
CPP_FLAGS := -cpp 
CC        := nvc++
FC        := mpif90 
ifeq ($(DO_DBG),1)
  DBG       := -Minform=inform -Mchkstk -g -O0 -traceback -Mbounds
else
  OPT       := -Minfo=accel -fast
endif
PRE       := #-r8

# Take all the compiler flags together
FFLAGS  := $(OPT) $(DBG) $(PRE)
# _DECOMP_Z: z is never split across ranks (only x and y, via dims_in in dns.in).
# Required by the IBM wall: the code uses the local k index for the solid layers (k <= IBM_h),
# which is only correct if every rank holds the full z column (as in the CPU build).
DFLAGS  := -D_TIMING -D_EPA2A -D_DECOMP_Z #-D_TWOD
DFLAGS  += #-D_OVERWRITE -D_EVEN # FFLAGS_2DECOMP
LDFLAGS :=

# Architecture switches
#
# NOTE: GPU compilation is enabled with FFLAGS and DFLAGS (see below)
#
USE_NVTX = 0

# Required for FFTW
FFTW_HOME := /leonardo/prod/spack/06/install/0.22/linux-rhel8-icelake/gcc-12.2.0/fftw-3.3.10-f3ms2lmqzjugb43xzrxjkvmvohumyruy
LDFLAGS   += -L${FFTW_HOME}/lib -Wl,-rpath,${FFTW_HOME}/lib -lfftw3

# GPU compute capability (80 = A100 on Leonardo); override with e.g. make GPU_CC=70
GPU_CC    ?= 80
# mem:managed: every allocatable array lives in CUDA managed memory, so arrays without
# an explicit managed attribute (e.g. mu_t, rhocp, psiold in main) are also present on the GPU
FFLAGS    += -cuda -acc -gpu=cc$(GPU_CC),mem:managed  -cudalib=cufft,curand 
DFLAGS    += -D_EPHC
# USE_SOLVER_GPU=1: pressure solved on the GPU (solver_gpu: cuFFT, device transposes, IBM offset,
# PP/NN/DD/ND in x,y). Default 0: solver_cpu (FFTW + host transposes), validated against the CPU build.
USE_SOLVER_GPU ?= 0
ifeq ($(USE_SOLVER_GPU),1)
DFLAGS    += -D_USE_SOLVER_GPU
endif
# GPU_MPI=1: MPI works directly on GPU buffers (needs CUDA-aware MPI);
# GPU_MPI=0 does NOT compile with _EPA2A (transpose_z_to_xc reads the 2decomp buffers in a cuf kernel)
GPU_MPI   ?= 1
ifeq ($(GPU_MPI),1)
DFLAGS    += -D_GPU_MPI
endif

# Required for INIT_MONTECARLO
#GSL_LIB   += -L~/lib -lgsl -lgslcblas -lm -lstdc++
#GSL_INC   += -I~/include 

# Required for NVTX
NVTX_LIB   += -lnvToolsExt
